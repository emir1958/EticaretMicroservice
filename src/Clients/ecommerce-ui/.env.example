# Bu dosyayı .env.local olarak kopyalayıp değerleri ortamına göre düzenle.
# Vite VITE_ ön ekli değişkenleri build anında bundle'a gömer: buraya secret yazılmaz.

# API Gateway adresi (sonunda / olmadan). Geliştirmede boş bırakılırsa http://localhost:5000 kullanılır.
VITE_API_URL=http://localhost:5000
