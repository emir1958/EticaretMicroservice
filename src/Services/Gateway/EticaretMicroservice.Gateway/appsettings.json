{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/Products/{**catch-all}"
        }
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/Auth/{**catch-all}"
        }
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      }
    },
    "basket-route": { // 👈 EKSİK OLAN KISIM BURASIYDI
      "ClusterId": "basket-cluster",
      "Match": {
        "Path": "/api/basket/{**catch-all}"
      }
    },
    "stock-route": {
      "ClusterId": "stock-cluster",
      "Match": {
        "Path": "/api/stocks/{**catch-all}"
      }
    },
    "auth-route": {
      "ClusterId": "auth-cluster",
      "Match": {
        "Path": "/api/auth/{**catch-all}"
      }
    }
  },

  "Clusters": {
    "catalog-cluster": {
      "Destinations": {
        "destination1": {
          "Address": "http://localhost:5113"
        }
      }
    },
    "identity-cluster": {
      "Destinations": {
        "destination1": {
          "Address": "http://localhost:5243"
        }
      }
    },
    "basket-cluster": {
      "Destinations": {
        "destination1": {
          "Address": "http://localhost:5290"
        }
      }
    },
    "order-cluster": {
      "Destinations": {
        "destination1": {
          "Address": "http://localhost:5051" // Order.WebApi'nin çalıştığı port
        }
      }
    },
    "stock-cluster": {
      "Destinations": {
        "destination1": {
          "Address": "http://localhost:5027" // Stock.API'nin çalıştığı Port
        }
      }
    },
    "auth-cluster": {
      "Destinations": {
        "destination1": { "Address": "http://localhost:5005" } // Identity.Api'nin Portu
      }
    }
  }
} 
