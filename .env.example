# Copy this file to .env and fill in real values. Never commit .env.
# docker-compose reads these variables; services fail fast if a required one is missing.

# 🔒 SQL Server (sa) password — must satisfy SQL Server complexity rules
SQL_SA_PASSWORD=

# 🔒 RabbitMQ credentials (names must match docker-compose.yml)
RABBITMQ_USER=guest
RABBITMQ_PASS=

# 🔒 JWT — SecretKey must be at least 32 characters (HMAC-SHA256)
JWT_SECRET_KEY=
JWT_ISSUER=EticaretIdentityServer
JWT_AUDIENCE=EticaretGateway

# 🔒 Initial admin account created by Identity.Api on first start
ADMIN_SEED_EMAIL=admin@eticaret.com
ADMIN_SEED_PASSWORD=

# 🌐 Gateway & Aspire
OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire-dashboard:18889
