# Copy this file to .env and fill in real values. Never commit .env.
# docker-compose reads these variables; services fail fast if a required one is missing.

# 🔒 SQL Server (sa) password — must satisfy SQL Server complexity rules
SQL_SA_PASSWORD=

# 🔒 RabbitMQ credentials (names must match docker-compose.yml)
RABBITMQ_USER=guest
RABBITMQ_PASS=

# 🔒 JWT (RS256) — only Identity holds the private key and signs tokens; the other services verify them
# with the public key they fetch from Identity (/.well-known/jwks.json). Value = base64 of a PEM private key.
# Generate one (Git Bash / Linux / macOS):
#   openssl genrsa 2048 | base64 | tr -d '\n'
# Replacing the key invalidates every token it signed, including refresh tokens: all users have to sign in again.
JWT_PRIVATE_KEY=
# Optional: access token lifetime in minutes (default 15)
# JWT_ACCESS_TOKEN_MINUTES=15
JWT_ISSUER=EticaretIdentityServer
JWT_AUDIENCE=EticaretGateway

# 🔒 Initial admin account created by Identity.Api on first start
ADMIN_SEED_EMAIL=admin@eticaret.com
ADMIN_SEED_PASSWORD=

# 🧪 Sample data (development only): adds sample products, customers and past orders on startup.
# Runs once, never modifies existing records. Sample customers use @ornek.test e-mails and cannot log in.
SEED_SAMPLE_DATA=false

# 🌐 Gateway & Aspire
OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire-dashboard:18889
